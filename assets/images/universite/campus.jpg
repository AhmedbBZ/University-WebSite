<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" fill="none">
  <!-- Fond ciel -->
  <rect width="1200" height="800" fill="#1A3F7A"/>
  <rect width="1200" height="400" fill="url(#sky)"/>
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#0D2B5E"/>
      <stop offset="100%" stop-color="#1A5276"/>
    </linearGradient>
    <linearGradient id="ground" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#1A5276"/>
      <stop offset="100%" stop-color="#0D2B5E"/>
    </linearGradient>
  </defs>

  <!-- Bâtiment principal -->
  <rect x="200" y="300" width="800" height="400" fill="#0A1F3D"/>
  <rect x="250" y="250" width="700" height="350" fill="#1A3F7A"/>

  <!-- Colonnes -->
  <rect x="300" y="300" width="30" height="300" fill="#0D2B5E"/>
  <rect x="400" y="300" width="30" height="300" fill="#0D2B5E"/>
  <rect x="500" y="300" width="30" height="300" fill="#0D2B5E"/>
  <rect x="600" y="300" width="30" height="300" fill="#0D2B5E"/>
  <rect x="700" y="300" width="30" height="300" fill="#0D2B5E"/>
  <rect x="800" y="300" width="30" height="300" fill="#0D2B5E"/>
  <rect x="870" y="300" width="30" height="300" fill="#0D2B5E"/>

  <!-- Toit et fronton -->
  <polygon points="200,300 600,180 1000,300" fill="#C8A951" opacity="0.8"/>
  <rect x="500" y="230" width="200" height="70" fill="#0D2B5E"/>

  <!-- Fenêtres -->
  <rect x="310" y="340" width="60" height="80" rx="4" fill="#C8A951" opacity="0.3"/>
  <rect x="410" y="340" width="60" height="80" rx="4" fill="#C8A951" opacity="0.3"/>
  <rect x="510" y="340" width="60" height="80" rx="4" fill="#C8A951" opacity="0.5"/>
  <rect x="610" y="340" width="60" height="80" rx="4" fill="#C8A951" opacity="0.3"/>
  <rect x="710" y="340" width="60" height="80" rx="4" fill="#C8A951" opacity="0.3"/>
  <rect x="810" y="340" width="60" height="80" rx="4" fill="#C8A951" opacity="0.3"/>

  <!-- Entrée principale -->
  <rect x="520" y="460" width="160" height="140" rx="6" fill="#071A3E"/>
  <rect x="540" y="480" width="50" height="100" rx="4" fill="#C8A951" opacity="0.2"/>
  <rect x="610" y="480" width="50" height="100" rx="4" fill="#C8A951" opacity="0.2"/>

  <!-- Sol -->
  <rect x="0" y="600" width="1200" height="200" fill="#071A3E"/>
  <rect x="0" y="595" width="1200" height="10" fill="#C8A951" opacity="0.3"/>

  <!-- Allée -->
  <polygon points="500,600 700,600 800,800 400,800" fill="#0D2B5E" opacity="0.6"/>

  <!-- Palmiers / arbres -->
  <rect x="150" y="500" width="12" height="100" fill="#071A3E" rx="3"/>
  <circle cx="156" cy="490" r="40" fill="#1A5226" opacity="0.7"/>
  <rect x="1038" y="500" width="12" height="100" fill="#071A3E" rx="3"/>
  <circle cx="1044" cy="490" r="40" fill="#1A5226" opacity="0.7"/>

  <!-- Drapeau -->
  <line x1="600" y1="120" x2="600" y2="180" stroke="#C8A951" stroke-width="3"/>
  <rect x="600" y="120" width="50" height="30" fill="#E74C3C" rx="2"/>

  <!-- Texte -->
  <text x="600" y="570" font-family="Georgia,serif" font-size="24" font-weight="bold"
        fill="white" text-anchor="middle" opacity="0.9">Université de la Manouba</text>
  <text x="600" y="598" font-family="Arial,sans-serif" font-size="14"
        fill="#C8A951" text-anchor="middle" letter-spacing="2">Campus Principal – La Manouba</text>
</svg>
