<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 900" fill="none">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#071A3E"/>
      <stop offset="50%" stop-color="#0D2B5E"/>
      <stop offset="100%" stop-color="#1A3F7A"/>
    </linearGradient>
    <linearGradient id="gold" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#A88A35"/>
      <stop offset="50%" stop-color="#C8A951"/>
      <stop offset="100%" stop-color="#E2C97A"/>
    </linearGradient>
  </defs>

  <rect width="1600" height="900" fill="url(#bg)"/>

  <!-- Grille de points -->
  <pattern id="dots" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
    <circle cx="20" cy="20" r="1.5" fill="rgba(200,169,81,0.12)"/>
  </pattern>
  <rect width="1600" height="900" fill="url(#dots)"/>

  <!-- Cercles décoratifs -->
  <circle cx="200" cy="200" r="300" stroke="rgba(200,169,81,0.06)" stroke-width="2" fill="none"/>
  <circle cx="200" cy="200" r="200" stroke="rgba(200,169,81,0.08)" stroke-width="1.5" fill="none"/>
  <circle cx="1400" cy="700" r="400" stroke="rgba(200,169,81,0.05)" stroke-width="2" fill="none"/>

  <!-- Médaille centrale -->
  <circle cx="800" cy="400" r="220" fill="rgba(13,43,94,0.6)" stroke="url(#gold)" stroke-width="3"/>
  <circle cx="800" cy="400" r="180" fill="rgba(7,26,62,0.8)" stroke="rgba(200,169,81,0.3)" stroke-width="1"/>

  <!-- Trophée -->
  <path d="M760 320 L840 320 L850 380 C860 430 840 450 800 460 C760 450 740 430 750 380 Z"
        fill="url(#gold)" opacity="0.9"/>
  <rect x="785" y="458" width="30" height="30" fill="url(#gold)" opacity="0.8"/>
  <rect x="770" y="485" width="60" height="12" rx="3" fill="url(#gold)" opacity="0.8"/>
  <!-- Poignées -->
  <path d="M760 340 Q730 350 730 380 Q730 410 760 415" stroke="url(#gold)" stroke-width="4"
        fill="none" stroke-linecap="round"/>
  <path d="M840 340 Q870 350 870 380 Q870 410 840 415" stroke="url(#gold)" stroke-width="4"
        fill="none" stroke-linecap="round"/>

  <!-- Étoiles -->
  <text x="800" y="310" font-family="Arial" font-size="22" fill="#C8A951" text-anchor="middle" opacity="0.9">★★★</text>

  <!-- Texte -->
  <text x="800" y="560" font-family="Georgia,serif" font-size="36" font-weight="bold"
        fill="white" text-anchor="middle" letter-spacing="2">Classements Internationaux</text>
  <rect x="680" y="575" width="240" height="3" fill="url(#gold)" rx="2"/>
  <text x="800" y="615" font-family="Arial,sans-serif" font-size="18"
        fill="rgba(200,169,81,0.9)" text-anchor="middle" letter-spacing="4">UNIVERSITÉ DE LA MANOUBA</text>

  <!-- QS et THE badges -->
  <rect x="580" y="650" width="120" height="50" rx="8" fill="rgba(200,169,81,0.15)"
        stroke="rgba(200,169,81,0.4)" stroke-width="1.5"/>
  <text x="640" y="682" font-family="Arial,sans-serif" font-size="20" font-weight="bold"
        fill="white" text-anchor="middle">QS</text>

  <rect x="720" y="650" width="160" height="50" rx="8" fill="rgba(200,169,81,0.1)"
        stroke="rgba(200,169,81,0.3)" stroke-width="1.5"/>
  <text x="800" y="682" font-family="Arial,sans-serif" font-size="16" font-weight="bold"
        fill="white" text-anchor="middle">World Rankings</text>

  <rect x="900" y="650" width="120" height="50" rx="8" fill="rgba(200,169,81,0.15)"
        stroke="rgba(200,169,81,0.4)" stroke-width="1.5"/>
  <text x="960" y="682" font-family="Arial,sans-serif" font-size="20" font-weight="bold"
        fill="white" text-anchor="middle">THE</text>
</svg>
